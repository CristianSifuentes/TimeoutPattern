{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Timeouts": {
    "DefaultRequestTimeout": "00:00:10",
    "DefaultOperationTimeout": "00:00:03",
    "MinimumViableBudget": "00:00:00.020",

    "Propagation": {
      "HeaderName": "X-Request-Timeout-Ms",
      "HonorInbound": true,
      "PropagateOutbound": true,
      "NetworkAllowance": "00:00:00.015"
    },

    "Requests": {
      "products":        { "Timeout": "00:00:02.500" },
      "reports":         { "Timeout": "00:00:08", "HonorInboundDeadline": false },
      "reports.sales":   { "Timeout": "00:00:03" },
      "warehouse.stock": { "Timeout": "00:00:05" },
      "diagnostics":     { "Timeout": "00:00:01" }
    },

    "Operations": {
      "catalog":          { "Timeout": "00:00:00.500" },
      "pricing":          { "Timeout": "00:00:01.200", "Reserve": "00:00:00.050" },
      "pricing.tax":      { "Timeout": "00:00:00.300", "Strategy": "Pessimistic" },
      "inventory":        { "Timeout": "00:00:00.800", "Reserve": "00:00:00.100" },
      "reports.day":      { "Timeout": "00:00:00.750", "Reserve": "00:00:00.100" }
    }
  },

  "Simulation": {
    "Latency": {
      "catalog":   "00:00:00.040",
      "demand":    "00:00:00.120",
      "tax":       "00:00:00.060",
      "inventory": "00:00:00.150",
      "ledger":    "00:00:00.060"
    }
  },

  "Warehouse": {
    "BaseUrl": "http://localhost:5080/"
  }
}
